{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "pages/**/*.{vue,js,ts}",
    "layouts/**/*.{vue,js,ts}",
    "components/**/*.{vue,js,ts}",
    "scripts/**/*.js"
  ],
  "project": [
    "**/*.{vue,js,ts}"
  ],
  "ignore": [
    ".output/**",
    ".nuxt/**"
  ],
  "ignoreDependencies": [
    "@mdi/font",
    "eslint-plugin-import",
    "eslint-plugin-node",
    "eslint-plugin-promise",
    "eslint-plugin-vue",
    "eslint-plugin-jest",
    "stylelint-config-recommended",
    "stylus-loader",
    "node-fetch-native",
    "ufo",
    "sass-embedded",
    "vuetify-nuxt-module",
    "vue-eslint-parser",
    "@babel/preset-typescript"
  ]
}
