{
  "name": "reireias",
  "version": "1.1.0",
  "description": "Portfolio Site",
  "author": "reireias <reireias@gmail.com>",
  "private": true,
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "start-static": "http-server ./dist",
    "lint": "eslint --ext .js,.ts,.vue --ignore-path .gitignore .",
    "lintfix": "eslint --fix --ext .js,.ts,.vue --ignore-path .gitignore .",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\" --ignore-path .gitignore",
    "lint:style:fix": "stylelint \"**/*.{css,scss,vue}\" --ignore-path .gitignore --fix",
    "generate": "nuxt generate && echo 'reireias.dev' > dist/CNAME",
    "benchmark": "node scripts/benchmark.js https://reireias.github.io $(git rev-parse HEAD)",
    "test": "jest",
    "test:e2e": "playwright test",
    "capture": "playwright test test/e2e/take-captures.spec.ts",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@nuxtjs/composition-api": "^0.31.0",
    "@nuxtjs/pwa": "^3.3.5",
    "nuxt": "^2.15.7"
  },
  "devDependencies": {
    "@mdi/font": "^7.0.96",
    "@nuxt/types": "^2.15.7",
    "@nuxt/typescript-build": "^2.1.0",
    "@nuxtjs/eslint-config": "^6.0.1",
    "@nuxtjs/eslint-config-typescript": "^6.0.1",
    "@nuxtjs/vuetify": "^1.12.1",
    "@playwright/test": "^1.62.0",
    "@types/animejs": "^3.1.4",
    "@vue/composition-api": "^1.7.2",
    "@vue/test-utils": "^1.3.0",
    "animejs": "^3.2.1",
    "axios": "^1.1.3",
    "babel-jest": "^26.6.3",
    "dateformat": "^5.0.3",
    "dotenv": "^16.0.3",
    "eslint": "^7.28.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": ">=16.0.3",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-import": ">=2.22.0",
    "eslint-plugin-jest": "^24.7.0",
    "eslint-plugin-node": ">=11.1.0",
    "eslint-plugin-nuxt": ">=2.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-promise": ">=4.3.1",
    "eslint-plugin-standard": ">=5.0.0",
    "eslint-plugin-vue": "^7.20.0",
    "http-server": "^14.1.1",
    "jest": "^26",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "lint-staged": "13.3.0",
    "node-fetch-native": "^1.6.7",
    "nuxt-webfontloader": "^1.1.0",
    "postcss-html": "^1.8.1",
    "prettier": "^2.3.2",
    "qs": "^6.15.3",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended": "13.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^11.1.0",
    "stylus": "^0.59.0",
    "stylus-loader": "^3.0.2",
    "ts-jest": "^26",
    "ufo": "^1.6.4",
    "vue": "2.7.16",
    "vue-jest": "^4.0.1",
    "vue-template-compiler": "2.7.16",
    "vuetify": "2.5.10"
  }
