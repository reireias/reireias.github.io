{
  "name": "reireias",
  "version": "1.1.0",
  "description": "Portfolio Site",
  "author": "reireias <reireias@gmail.com>",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "start-static": "http-server ./dist",
    "lint": "eslint .",
    "lintfix": "eslint --fix .",
    "lint:style": "stylelint \"**/*.{css,scss,vue}\" --ignore-path .gitignore",
    "lint:style:fix": "stylelint \"**/*.{css,scss,vue}\" --ignore-path .gitignore --fix",
    "generate": "nuxi generate && rm -rf dist && cp -r .output/public dist && echo 'reireias.dev' > dist/CNAME",
    "audit:performance": "pnpm generate && start-server-and-test 'http-server ./dist -p 3000 -c-1 -s' http://127.0.0.1:3000 'unlighthouse-ci --site http://127.0.0.1:3000 && node scripts/verify-performance-audit.mjs'",
    "benchmark": "node scripts/benchmark.js https://reireias.github.io $(git rev-parse HEAD)",
    "test": "jest",
    "test:e2e": "playwright test",
    "capture": "playwright test test/e2e/take-captures.spec.ts",
    "ai:generate": "rulesync generate",
    "ai:check": "rulesync generate --check && rulesync doctor --strict",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.5",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.10.0",
    "@playwright/test": "^1.62.1",
    "@types/animejs": "^3.1.13",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/vue3-jest": "^29.2.6",
    "animejs": "^3.2.2",
    "axios": "^1.19.0",
    "babel-jest": "^29.7.0",
    "dateformat": "^5.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "lint-staged": "17.3.0",
    "nuxt": "^4.5.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "qs": "^6.15.3",
    "rulesync": "^16.9.1",
    "sass-embedded": "^1.100.0",
    "start-server-and-test": "^3.0.12",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "ufo": "^1.6.4",
    "unlighthouse": "^0.18.0",
    "vue": "3.5.41",
    "vue-eslint-parser": "^10.4.1"
  }
}
